{
  "name": "dsh-web-search-zerokey",
  "version": "1.1.0",
  "description": "零 key 联网搜索：不填任何 API key、不启任何本地服务、不消耗模型积分。多源聚合（Bing / Hacker News / GitHub / arXiv / npm / 掘金 / CSDN），中英文自动路由。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/**/*.js",
    "scripts/verify.mjs",
    "scripts/lint.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "web-search",
    "search",
    "zero-key",
    "no-api-key",
    "keyless",
    "mcp",
    "bing"
  ],
  "author": {
    "name": "husongzhen",
    "email": "husongzhen@noreply.gitcode.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AllenCoderBug/dsh-web-search-zerokey.git"
  },
  "homepage": "https://github.com/AllenCoderBug/dsh-web-search-zerokey#readme",
  "bugs": {
    "url": "https://github.com/AllenCoderBug/dsh-web-search-zerokey/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/*.test.mjs\"",
    "lint": "node scripts/lint.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2",
    "@deepseek-ai/dsh-web": ">=0.1.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
